; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gd-pal"
config/version="0.3.0"
run/main_scene="res://scenes/app/app.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

McpInteractionServer="*res://addons/godot_mcp/mcp_interaction_server.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true
window/handheld/orientation=6
window/per_pixel_transparency/allowed.mobile=false

[dotnet]

project/assembly_name="gd-pal"

[editor_plugins]

enabled=PackedStringArray("res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/vrm/plugin.cfg", "res://addons/gd_pal_export/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.095, 1)
